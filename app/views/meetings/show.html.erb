<% content_for :title, "#{@meeting[:title]} - 모여봐" %>

<div class="w-full max-w-lg mx-auto py-16">
  <%= link_to "← 목록으로 돌아가기", meetings_path, class: "text-sm text-gray-500 hover:text-indigo-600" %>

  <h1 class="text-3xl font-bold text-gray-900 mt-4 mb-6"><%= @meeting[:title] %></h1>

  <dl class="space-y-4">
    <div>
      <dt class="text-sm text-gray-500">날짜</dt>
      <dd class="text-gray-900"><%= @meeting[:held_on] %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">장소</dt>
      <dd class="text-gray-900"><%= @meeting[:location] %></dd>
    </div>
    <div>
      <dt class="text-sm text-gray-500">설명</dt>
      <dd class="text-gray-900 whitespace-pre-line"><%= @meeting[:description] %></dd>
    </div>
  </dl>
</div>
